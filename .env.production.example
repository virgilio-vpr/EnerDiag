# Copy to .env.production (ignored). Use the same file for --env-file and PRODUCTION_ENV_FILE.
PRODUCTION_ENV_FILE=.env.production
APP_NAME=EnerDiag
APP_KEY=
APP_URL=https://enerdiag.example.com
FRONTEND_URL=https://enerdiag.example.com
CORS_ALLOWED_ORIGINS=https://enerdiag.example.com
APP_TIMEZONE=America/Sao_Paulo
ENERDIAG_TERMS_VERSION=1.0
DB_DATABASE=enerdiag
DB_USERNAME=enerdiag
DB_PASSWORD=
TLS_CERTIFICATE=/absolute/path/fullchain.pem
TLS_PRIVATE_KEY=/absolute/path/privkey.pem
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=contato@enerdiag.example.com
MAIL_FROM_NAME=EnerDiag
